{
  "extends": [
    "github>kubewarden/github-actions//renovate-config/default"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned tool versions annotated with renovate directives",
      "managerFilePatterns": [
        "/(^|/)\\.github/.+\\.ya?ml$/",
        "/(^|/)Makefile$/",
        "/(^|/)Dockerfile\\.[^/]+$/",
        "/^docs/crds/config\\.yml$/",
        "/^test/.+\\.go$/"
      ],
      "matchStrings": [
        "(?:#|//) renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*(?:ARG\\s+|ENV\\s+)?\\S+?\\s*(?:\\?=|:?=|:)\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the container images of the Go test suites annotated with renovate directives",
      "managerFilePatterns": [
        "/^test/.+\\.go$/"
      ],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>docker)\\s*\\n\\s*\\S+\\s*=\\s*\"(?<depName>[^\"\\s:]+):(?<currentValue>[^\"\\s@]+)\""
      ]
    }
  ],
  "kubernetes": {
    "description": "Update the container images of the test manifests",
    "managerFilePatterns": [
      "/^test/manifests/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Update the Kubernetes modules together. The excluded modules do not follow the Kubernetes release cycle",
      "groupName": "kubernetes",
      "matchPackageNames": [
        "k8s.io/**",
        "!k8s.io/klog/v2",
        "!k8s.io/kube-openapi",
        "!k8s.io/utils",
        "!k8s.io/gengo/v2",
        "sigs.k8s.io/controller-runtime"
      ]
    },
    {
      "description": "The release PR of updatecli sets the image tags in the chart values. Renovate must not change them",
      "matchManagers": [
        "helm-values"
      ],
      "matchFileNames": [
        "charts/gateway-protector/values.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Update the Makefile pin and the CI action of golangci-lint together",
      "groupName": "golangci-lint",
      "matchPackageNames": [
        "golangci/golangci-lint"
      ]
    },
    {
      "description": "go-ftw v2.6.1 and later refuse to send the raw CR/LF characters of some CRS v4.25.0 regression tests, for example 921140-1. Remove this rule when the CRS version in go.mod has updated tests",
      "matchPackageNames": [
        "github.com/coreruleset/go-ftw/v2"
      ],
      "allowedVersions": "<2.6.1"
    }
  ]
}
